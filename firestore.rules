rules_version = '2';
// 제니의 영어나라 — 가족 코드 기록 공유 규칙
// - 로그인(익명)한 기기만, 가족 코드 형식(ABCD-EFGH-JK)의 문서 하나만 읽고 쓸 수 있음
// - 목록 조회(list)와 삭제는 막음 → 코드를 모르면 남의 기록을 찾을 수 없음
service cloud.firestore {
  match /databases/{database}/documents {
    function validCode(c) {
      return c.matches('^[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{2}$');
    }
    match /families/{code} {
      allow get: if request.auth != null && validCode(code);
      allow create, update: if request.auth != null && validCode(code)
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000;
      allow list, delete: if false;
    }
  }
}
